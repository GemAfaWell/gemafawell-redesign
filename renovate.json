{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":approveMajorUpdates",
    ":enableVulnerabilityAlerts",
    ":automergeDisabled"
  ],
  "prConcurrentLimit": 3,
  "lockFileMaintenance": {
    "enabled": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "assignees": [
      "GemAfaWell"
    ],
    "automerge": false,
    "addLabels": [
      "security"
    ]
  }
}
